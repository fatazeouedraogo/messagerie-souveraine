# Exemple de configuration. NE PAS utiliser tel quel : ./scripts/install.sh génère un .env
# avec des secrets aléatoires. Ce fichier .env ne doit jamais être publié (voir .gitignore).

# Nom de domaine de la messagerie. Pour un essai sur une machine : gouv.localhost (HTTP).
DOMAIN=gouv.localhost
# http pour l'essai local ; https en production (certificat TLS devant ou dans Nginx).
SCHEME=http
HTTP_PORT=80

# Comptes fictifs de démonstration (true / false)
DEMO_SEED=true

# --- secrets (générés par install.sh) ---
POSTGRES_PASSWORD=CHANGER
SYNAPSE_DB_PASSWORD=CHANGER
KC_DB_PASSWORD=CHANGER
API_DB_PASSWORD=CHANGER
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGER
SYNAPSE_OIDC_SECRET=CHANGER
ADMIN_API_CLIENT_SECRET=CHANGER
SYNAPSE_REGISTRATION_SHARED_SECRET=CHANGER
SYNAPSE_MACAROON_SECRET=CHANGER
SYNAPSE_FORM_SECRET=CHANGER
SUPERADMIN_PASSWORD=CHANGER
