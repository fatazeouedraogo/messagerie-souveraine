# Point d'entrée unique. Fichier généré, ne pas éditer à la main.
# Résolution à l'exécution (resolver Docker) : Nginx démarre même si un service est encore en cours de lancement.
worker_processes auto;
events { worker_connections 1024; }

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  server_tokens off;
  resolver 127.0.0.11 valid=10s ipv6=off;

  # Ne jamais journaliser les paramètres d'URL (peuvent contenir des codes de connexion).
  log_format minimal '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';
  access_log /var/log/nginx/access.log minimal;

  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/s;
  limit_req_zone $binary_remote_addr zone=api:10m  rate=30r/s;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Frame-Options "SAMEORIGIN" always;

  # --- Matrix (Synapse) ---
  server {
    listen 80;
    server_name matrix.${DOMAIN};
    client_max_body_size 50M;

    # Interface d'administration de Synapse : jamais exposée.
    location /_synapse/admin { return 404; }

    location / {
      set $up http://synapse:8008;
      proxy_pass $up;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_read_timeout 600s;
    }
    location = /_matrix/client/v3/login {
      limit_req zone=auth burst=20 nodelay;
      set $up http://synapse:8008;
      proxy_pass $up;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }

  # --- Domaine racine : découverte du serveur Matrix par les clients ---
  server {
    listen 80;
    server_name ${DOMAIN};
    location = /.well-known/matrix/client {
      default_type application/json;
      add_header Access-Control-Allow-Origin "*" always;
      return 200 '{"m.homeserver":{"base_url":"${SCHEME}://matrix.${DOMAIN}"}}';
    }
    location / { return 302 ${SCHEME}://chat.${DOMAIN}; }
  }

  # --- Client Element ---
  server {
    listen 80;
    server_name chat.${DOMAIN};
    location / {
      set $up http://element:80;
      proxy_pass $up;
      proxy_set_header Host $host;
      add_header Content-Security-Policy "frame-ancestors 'self'" always;
    }
  }

  # --- Annuaire d'identités (Keycloak) ---
  server {
    listen 80;
    server_name auth.${DOMAIN};
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    # Console d'administration de Keycloak : jamais exposée.
    location /admin { return 404; }
    location /realms/master { return 404; }
    location /metrics { return 404; }
    location /health { return 404; }

    location / {
      limit_req zone=auth burst=30 nodelay;
      set $up http://keycloak:8080;
      proxy_pass $up;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $host;
    }
  }

  # --- API d'administration ---
  server {
    listen 80;
    server_name api.${DOMAIN};
    client_max_body_size 1m;
    location / {
      limit_req zone=api burst=60 nodelay;
      set $up http://api:3000;
      proxy_pass $up;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }

  # --- Console web d'administration (fichiers statiques, aucune ressource externe) ---
  server {
    listen 80;
    server_name admin.${DOMAIN};
    root /srv/admin;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${SCHEME}://api.${DOMAIN} ${SCHEME}://auth.${DOMAIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    # Adresses publiques injectées à l'installation (voir infra/templates/admin-config.js.tmpl).
    location = /config.js {
      alias /gen/admin-config.js;
      add_header Cache-Control "no-store";
    }
    location / { try_files $uri /index.html; }
  }
}
