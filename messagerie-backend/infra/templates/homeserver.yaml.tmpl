# Synapse : serveur Matrix de la messagerie souveraine (fichier généré, ne pas éditer à la main).
server_name: "${DOMAIN}"
public_baseurl: "${SCHEME}://matrix.${DOMAIN}/"
pid_file: /data/homeserver.pid
report_stats: false
log_config: "/config/log.config"
media_store_path: /data/media_store
signing_key_path: "/data/${DOMAIN}.signing.key"

macaroon_secret_key: "${SYNAPSE_MACAROON_SECRET}"
form_secret: "${SYNAPSE_FORM_SECRET}"
registration_shared_secret: "${SYNAPSE_REGISTRATION_SHARED_SECRET}"

listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    bind_addresses: ["0.0.0.0"]
    resources:
      # Pas de ressource « federation » : le serveur n'écoute aucun serveur extérieur.
      - names: [client]
        compress: false

database:
  name: psycopg2
  args:
    user: synapse
    password: "${SYNAPSE_DB_PASSWORD}"
    database: synapse
    host: postgres
    cp_min: 5
    cp_max: 10

# --- Souveraineté : aucune fédération, aucune ouverture publique ---
federation_domain_whitelist: []
allow_public_rooms_over_federation: false
allow_public_rooms_without_auth: false
room_list_publication_rules:
  - action: deny
enable_registration: false
allow_guest_access: false
url_preview_enabled: false
presence:
  enabled: false
trusted_key_servers: []
suppress_key_server_warning: true

# --- Chiffrement de bout en bout : actif par défaut pour tous les salons ---
encryption_enabled_by_default_for_room_type: all

# --- Annuaire interne : un agent retrouve ses collègues ---
user_directory:
  enabled: true
  search_all_users: true
  prefer_local_users: true

# --- Durée de conservation des messages (salons « Diffusion restreinte » / « Confidentiel ») ---
retention:
  enabled: true
  allowed_lifetime_min: 5m
  allowed_lifetime_max: 1y
  purge_jobs:
    - longest_max_lifetime: 3d
      interval: 5m
    - shortest_max_lifetime: 3d
      interval: 12h

# --- Authentification : uniquement via Keycloak (mot de passe + TOTP) ---
# Le compte de service de l'API garde une connexion par mot de passe ; les comptes agents
# n'ont AUCUN mot de passe local (créés sans mot de passe par l'API d'administration).
password_config:
  enabled: true
  policy:
    enabled: true
    minimum_length: 14
oidc_providers:
  - idp_id: keycloak
    idp_name: "Compte gouvernemental"
    issuer: "${SCHEME}://auth.${DOMAIN}/realms/gouv"
    client_id: "synapse"
    client_secret: "${SYNAPSE_OIDC_SECRET}"
    client_auth_method: client_secret_post
    scopes: ["openid", "profile", "email"]
    allow_existing_users: true
    backchannel_logout_enabled: true
    user_mapping_provider:
      config:
        localpart_template: "{{ user.preferred_username }}"
        display_name_template: "{{ user.name }}"
        email_template: "{{ user.email }}"

# Limites de débit : protègent contre le bourrage d'identifiants.
rc_login:
  address:
    per_second: 0.2
    burst_count: 5
  account:
    per_second: 0.2
    burst_count: 5
  failed_attempts:
    per_second: 0.2
    burst_count: 5

max_upload_size: 50M
